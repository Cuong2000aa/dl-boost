{
  "manifest_version": 3,
  "name": "PulseDM",
  "description": "Trình quản lý tải xuống kiểu IDM — tăng tốc nhiều kết nối, tạm dừng/tiếp tục, hàng đợi.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PulseDM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "downloads.shelf",
    "storage",
    "contextMenus",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["manager/manager.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
